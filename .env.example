# ==============================================================================
# eRTMAC-NWIS PRODUCTION ENVIRONMENT TEMPLATE (Phase 09)
# ==============================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env.production
#   2. Replace ALL placeholder values with actual production credentials
#   3. NEVER commit .env.production to version control
#   4. Store production secrets in a vault (HashiCorp Vault, AWS Secrets Manager)
# ==============================================================================

# --- Application Configuration ---
ENVIRONMENT=production
APP_NAME=eRTMAC-NWIS
APP_VERSION=1.0.0
DEBUG=false

HOST=0.0.0.0
PORT=8000

# --- SECURITY (MUST CHANGE) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=MUST_CHANGE_IN_PRODUCTION_USE_SECRETS_TOKEN_URLSAFE_64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
POSTGRES_DB=nwis_db
POSTGRES_USER=nwis_app
POSTGRES_PASSWORD=MUST_CHANGE_IN_PRODUCTION
DATABASE_URL=postgresql+psycopg2://nwis_app:MUST_CHANGE_IN_PRODUCTION@db:5432/nwis_db
DB_PORT=5432

# --- Redis ---
REDIS_PASSWORD=MUST_CHANGE_IN_PRODUCTION
REDIS_URL=redis://:MUST_CHANGE_IN_PRODUCTION@redis:6379/0
REDIS_PORT=6379

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://nwis.oilindia.in,https://ertmac.oilindia.in

# --- Application Ports ---
APP_PORT=8000

# --- NWIS Operational Parameters ---
DEFAULT_LOOKAHEAD_WINDOW_METERS=75.0
MAX_OFFSET_SEARCH_RADIUS_KM=15.0
DEFAULT_OFFSET_SEARCH_RADIUS_KM=5.0
OCR_CONFIDENCE_THRESHOLD=0.85
STRICT_EVIDENCE_REQUIRED=true

# --- AI/ML Configuration ---
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
